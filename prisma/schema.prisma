generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADVERTISER
  ADMIN
}

enum GiveawayStatus {
  DRAFT // advertiser is still editing, not submitted
  PENDING // submitted by advertiser, awaiting admin review
  ACTIVE // approved and live
  PAUSED // temporarily hidden by admin
  ENDED // finished / winner drawn
  REJECTED // admin declined
}

enum TaskStatus {
  PENDING // awaiting admin review
  APPROVED // live
  REJECTED // admin declined
}

enum TaskType {
  PARTNER_SIGNUP
  APP_INSTALL
  VISIT_WEBSITE
  WATCH_VIDEO
  NEWSLETTER_SIGNUP
  YOUTUBE_SUBSCRIBE
  YOUTUBE_LIKE
  INSTAGRAM_FOLLOW
  TIKTOK_FOLLOW
  X_FOLLOW
  FACEBOOK_FOLLOW
  DISCORD_JOIN
  TELEGRAM_JOIN
  TWITCH_FOLLOW
  REFER_FRIEND
  SURVEY
  CUSTOM
}

enum VerificationMode {
  POSTBACK // server-to-server postback from advertiser (highest quality)
  MANUAL // user claims, admin/advertiser reviews proof
  TIMER // user must stay on target for N seconds, then auto-credit (lowest trust)
}

enum CompletionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  // advertiser-only: secret key advertisers include in postback calls
  postbackKey  String?  @unique
  company      String?
  website      String?  @db.Text
  signupIp     String?
  createdAt    DateTime @default(now())

  tasks            Task[]       @relation("AdvertiserTasks")
  clicks           Click[]
  completions      Completion[]
  wins             Giveaway[]   @relation("GiveawayWinner")
  createdGiveaways Giveaway[]   @relation("GiveawayCreator")
}

model Giveaway {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  prize       String
  imageUrl    String?        @db.Text
  status      GiveawayStatus @default(PENDING)
  endsAt      DateTime
  // optional target: close entries once this many sign-ups (approved
  // conversions) are collected, so an advertiser's prize isn't drawn before
  // they hit their goal. null = date-only.
  signupGoal  Int?
  winnerId    String?
  winner      User?          @relation("GiveawayWinner", fields: [winnerId], references: [id])
  // who submitted this giveaway (advertiser self-serve); null for legacy/admin
  createdById String?
  createdBy   User?          @relation("GiveawayCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // admin's note when rejecting, shown back to the advertiser
  reviewNote  String?        @db.Text
  createdAt   DateTime       @default(now())

  tasks Task[]
}

model Task {
  id           String           @id @default(cuid())
  giveawayId   String
  giveaway     Giveaway         @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  advertiserId String?
  advertiser   User?            @relation("AdvertiserTasks", fields: [advertiserId], references: [id])
  type         TaskType
  title        String
  description  String           @db.Text
  // where the user is sent; {click_id} placeholder is replaced with the tracked id
  targetUrl    String           @db.Text
  entries      Int              @default(1)
  verification VerificationMode @default(POSTBACK)
  timerSeconds Int              @default(30)
  // moderation state; only APPROVED tasks are shown to users
  status       TaskStatus       @default(PENDING)
  // admin's note when rejecting, shown back to the advertiser
  reviewNote   String?          @db.Text
  // advertiser pause switch (independent of moderation)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())

  clicks      Click[]
  completions Completion[]
}

model Click {
  id        String   @id @default(cuid())
  clickId   String   @unique // token passed to advertiser and echoed back in postback
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  completion Completion?

  @@index([taskId, userId])
}

model Completion {
  id         String           @id @default(cuid())
  taskId     String
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clickDbId  String?          @unique
  click      Click?           @relation(fields: [clickDbId], references: [id])
  status     CompletionStatus @default(PENDING)
  source     VerificationMode
  // proof link/username submitted by user for MANUAL tasks
  proof      String?          @db.Text
  // payout reported by advertiser postback, informational
  payout     Float?
  ip         String?
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?

  @@unique([taskId, userId])
}
